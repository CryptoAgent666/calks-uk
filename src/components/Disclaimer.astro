---
interface Props {
  category?: string
  slug?: string
}

const { category = '', slug = '' } = Astro.props

// Where the figures behind each category actually come from. Categories with
// no government rates (tools, math) get no sourcing sentence at all.
const SOURCE_BY_CATEGORY: Record<string, string> = {
  tax: 'HMRC and GOV.UK',
  pay: 'HMRC and GOV.UK',
  pension: 'HMRC, GOV.UK and The Pensions Regulator',
  business: 'HMRC and GOV.UK',
  benefits: 'GOV.UK and the DWP',
  mortgage: "lenders' published rates and FCA guidance",
  loans: "lenders' published rates and FCA guidance",
  investment: 'HMRC limits and FCA guidance',
  insurance: 'ABI and FCA guidance',
  auto: 'DVLA and GOV.UK',
  energy: 'Ofgem and Ofwat',
  education: 'Student Finance England, SAAS and GOV.UK',
  immigration: 'GOV.UK and UKVI',
  legal: 'GOV.UK and HM Courts & Tribunals Service',
  farming: 'Defra and GOV.UK',
  health: 'NHS guidance',
  building: 'manufacturer coverage data and UK building regulations',
  gardening: 'RHS guidance and manufacturer coverage data',
}

// A handful of calculators sit in a category whose default source is wrong for
// them: student loan rates are set by the SLC, not by lenders and the FCA, and
// the devolved property taxes are nothing to do with HMRC.
const SOURCE_BY_SLUG: Record<string, string> = {
  'plaster-calculator': 'British Gypsum product data and Checkatrade price guides',
  'paint-calculator': 'Dulux product data, HSE guidance and Checkatrade price guides',
  'gravel-calculator': 'the Planning Portal, GOV.UK front garden guidance and merchant data',
  'wallpaper-calculator': 'published wallpaper guides and Checkatrade price guides',
  'student-loan-repayment-calculator': 'Student Finance England, SAAS and GOV.UK',
  'student-loan-early-repay-calculator': 'Student Finance England, SAAS and GOV.UK',
  'student-loan-interest-calculator': 'Student Finance England, SAAS and GOV.UK',
  'postgraduate-loan-calculator': 'Student Finance England, SAAS and GOV.UK',
  'student-loan-plan4-calculator': 'SAAS, the Student Loans Company and GOV.UK',
  'lbtt-ltt-calculator': 'Revenue Scotland and the Welsh Revenue Authority',
  'scottish-income-tax-calculator': 'the Scottish Government and GOV.UK',
  // State Pension age is set by statute and administered by DWP, not The Pensions Regulator
  'state-pension-age-calculator': 'GOV.UK, the DWP and the Pensions Acts on legislation.gov.uk',
  // grade and exam tools: no student-finance figures behind them
  'gcse-grade-calculator': 'Ofqual',
  'a-level-grade-calculator': 'Ofqual and UCAS',
  'gpa-calculator': 'UK degree classification conventions and the Higher Education Academy GPA scale',
  'exam-score-calculator': '',
  'weighted-grade-calculator': '',
  'progress-8-calculator': 'DfE and Standards and Testing Agency publications',
  'ks2-sats-scaled-score-calculator': 'DfE and Standards and Testing Agency publications',
  'degree-classification-calculator': "universities' published regulations",
  // not student finance, lending or UKVI: statute and statistics instead
  'cost-of-living-comparison-calculator': 'ONS and GOV.UK council tax data',
  'service-charge-calculator': 'the Landlord and Tenant Act 1985 and GOV.UK leasehold guidance',
  // London road-user charges are TfL's, not DVLA's
  'ulez-calculator': 'Transport for London (TfL)',
  'congestion-charge-calculator': 'Transport for London (TfL)',
  // legal minimums from HSE and the 1969 Act; premium rates are the site's own indicative assumptions
  'employers-liability-calculator': "HSE guidance and the Employers' Liability (Compulsory Insurance) Act 1969, with indicative premium rates,",
  // NS&I sets the prize rate, odds and limits; the tax comparison is GOV.UK's
  'premium-bonds-calculator': 'NS&I and GOV.UK',
  // premiums are estimated from one broker's published quotes
  'critical-illness-calculator': 'published broker quotes (iam insured)',
  // the tax figures are GOV.UK's; the FCA sets none of them
  'cost-of-delay-calculator': 'GOV.UK and HMRC',
  'weight-loss-calculator': 'NHS, NICE and MHRA guidance',
  'heart-rate-zone-calculator': 'NHS and BHF guidance',
  'protein-intake-calculator': 'UK dietary reference values (British Nutrition Foundation, GOV.UK)',
  'macro-calculator': 'GOV.UK dietary recommendations, NHS and NICE guidance',
  'waist-hip-ratio-calculator': 'WHO, NICE and NHS guidance',
  'sleep-calculator': 'NHS and National Sleep Foundation guidance',
  // the RHS publishes no liner, pump or stocking rule behind these figures
  'pond-volume-calculator': '',
  'lawn-seed-calculator': 'RHS and Johnsons guidance and retailer listings',
  'topsoil-calculator': 'RHS guidance and retailer listings',
  'mulch-calculator': 'RHS guidance and retailer listings',
  'fence-paint-calculator': 'Ronseal and retailer product data',
  'radiator-btu-calculator': 'published radiator data from Zehnder and QS Supplies',
  'kitchen-cost-calculator': "Checkatrade's published cost guide and Approved Document P",
  'bathroom-cost-calculator': "Checkatrade's published cost guide and GOV.UK building regulations guidance",
  'fencing-calculator': "the Planning Portal, HM Land Registry and Checkatrade's published cost guide",
  'decking-calculator': 'the Planning Portal; prices and screw counts are estimates',
  'concrete-calculator': 'Approved Document A, Checkatrade and supplier data',
  // scheme and tax rules, not lender or FCA figures
  'first-homes-scheme-calculator': 'GOV.UK',
  'buy-to-let-yield-calculator': 'GOV.UK and HMRC',
  // planning rules from the Planning Portal, prices from published cost guides, no manufacturer data
  'extension-cost-calculator': 'the Planning Portal and published cost guides (Checkatrade, BestBuilders)',
  'staircase-calculator': 'Approved Document K and published cost guides (Checkatrade)',
}

// A health page that has nothing to do with diet should not send readers to a dietitian.
const ADVICE_BY_SLUG: Record<string, string> = {
  'heart-rate-zone-calculator': 'It is not medical advice: talk to your GP or specialist before acting on the numbers.',
  'waist-hip-ratio-calculator': 'It is not medical advice: talk to your GP before acting on the numbers.',
  'sleep-calculator': 'It is not medical advice: talk to your GP if sleep problems affect your daily life.',
}

const GRADE_SLUGS = new Set(['gcse-grade-calculator', 'a-level-grade-calculator', 'gpa-calculator', 'exam-score-calculator', 'weighted-grade-calculator', 'progress-8-calculator', 'ks2-sats-scaled-score-calculator', 'degree-classification-calculator'])

const TAX_YEAR_SLUGS = new Set([
  'student-loan-repayment-calculator',
  'student-loan-early-repay-calculator',
  'student-loan-interest-calculator',
  'postgraduate-loan-calculator',
  'student-loan-plan4-calculator',
])

const TAX_YEAR_CATEGORIES = new Set(['tax', 'pay', 'pension', 'business', 'benefits', 'investment', 'education'])

const ADVICE_BY_CATEGORY: Record<string, string> = {
  health: 'It is not medical advice: talk to your GP or a registered dietitian before acting on the numbers.',
  building: 'Confirm quantities with your supplier before ordering, and use a qualified tradesperson for structural work.',
  gardening: 'Confirm quantities with your supplier before ordering.',
  tools: 'Double-check any result you rely on.',
  math: 'Double-check any result you rely on.',
}

const source = SOURCE_BY_SLUG[slug] ?? SOURCE_BY_CATEGORY[category]
const period =
  !GRADE_SLUGS.has(slug) && (TAX_YEAR_CATEGORIES.has(category) || TAX_YEAR_SLUGS.has(slug)) ? 'the 2026/27 tax year' : '2026'
const advice =
  (GRADE_SLUGS.has(slug) ? 'It is not an official result: check grade boundaries with your exam board or university.' : undefined) ??
  ADVICE_BY_SLUG[slug] ??
  ADVICE_BY_CATEGORY[category] ??
  'It is not financial or tax advice: check anything you rely on against the official source or a qualified adviser.'
---

<div class="mt-8 p-4 rounded-xl bg-muted/50 border border-border text-sm text-muted-foreground">
  <p class="font-medium text-foreground mb-1">Disclaimer</p>
  <p>
    This calculator is for guidance only. {advice}
    {source && (GRADE_SLUGS.has(slug)
      ? ` Grade boundaries and conversions follow ${source} and are reviewed for ${period}.`
      : ` Rates and figures come from ${source} and are reviewed for ${period}.`)}
    Everything is calculated in your browser; nothing you enter is sent to our servers.
  </p>
</div>
