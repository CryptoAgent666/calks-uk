---
import { RATES_VERIFIED } from '@/data/site'

interface Props {
  lastUpdated?: string
  category?: string
  slug?: string
}
const { lastUpdated = 'April 2026', category, slug = '' } = Astro.props

// Grade and exam tools sit in the education category but have no student-finance
// figures behind them, so they get their own line and no dated rates badge.
const VERIFICATION_BY_SLUG: Record<string, string> = {
  'plaster-calculator': 'Checked against British Gypsum data and Checkatrade prices, 2026',
  'gcse-grade-calculator': 'Checked against Ofqual 9 to 1 grading, 2026',
  'a-level-grade-calculator': 'Checked against Ofqual and UCAS 2026 guidance',
  'gpa-calculator': 'Checked against the Higher Education Academy GPA scale and Office for Students data; classification is indicative',
  'exam-score-calculator': 'Methodology reviewed for 2026',
  'weighted-grade-calculator': 'Methodology reviewed for 2026',
  'progress-8-calculator': 'Checked against DfE and Standards and Testing Agency publications, 2026',
  'ks2-sats-scaled-score-calculator': 'Checked against DfE and Standards and Testing Agency publications, 2026',
  'degree-classification-calculator': 'Checked against published university regulations, 2026; classification is indicative',
  'cost-of-living-comparison-calculator': 'Checked against ONS and GOV.UK council tax data, 2026',
  'service-charge-calculator': 'Checked against the Landlord and Tenant Act 1985 and GOV.UK leasehold guidance',
  // London road-user charges are set by TfL, not DVLA
  'ulez-calculator': 'Checked against Transport for London (TfL) 2026 charges',
  'congestion-charge-calculator': 'Checked against Transport for London (TfL) 2026 charges',
  // the legal figures come from HSE and the 1969 Act; the premium rates are the site's own indicative assumptions
  'employers-liability-calculator': 'Checked against HSE guidance and the 1969 Act; premium rates are indicative',
  // the prize rate, odds and limits are NS&I's own, and neither HMRC nor the FCA sets them
  'premium-bonds-calculator': 'Checked against NS&I prize fund rate and prize tables, 2026',
  // premiums are estimated from one broker's published quotes
  'critical-illness-calculator': 'Premium estimates based on published broker quotes, 2026',
  // health pages: the sources actually read for them, not a GOV.UK rate table
  'weight-loss-calculator': 'Checked against NHS, NICE and MHRA guidance, 2026',
  'heart-rate-zone-calculator': 'Checked against NHS and BHF guidance, 2026; zones are estimates',
  'protein-intake-calculator': 'Checked against UK dietary reference values (British Nutrition Foundation, GOV.UK), 2026',
  'macro-calculator': 'Checked against GOV.UK dietary recommendations, NHS and NICE guidance, 2026',
  'waist-hip-ratio-calculator': 'Checked against WHO, NICE and NHS guidance, 2026',
  'sleep-calculator': 'Checked against NHS guidance, 2026; 90-minute cycles are a rule of thumb',
  // the RHS publishes no liner, pump or stocking rule to verify these figures against
  'pond-volume-calculator': 'Methodology reviewed for 2026',
  // cost guides and manufacturer data, not building regulations, sit behind most of these figures
  'radiator-btu-calculator': 'Correction factors from published radiator data, 2026; sizing is a rule of thumb',
  'kitchen-cost-calculator': "Prices from Checkatrade's March 2026 guide; electrical rules from Approved Document P",
  'bathroom-cost-calculator': "Prices from Checkatrade's March 2026 guide; electrical rules from GOV.UK building regulations guidance",
  'fencing-calculator': "Planning rules from the Planning Portal; prices from Checkatrade's February 2025 guide",
  'decking-calculator': 'Planning rules from the Planning Portal; prices and screw counts are estimates',
  'concrete-calculator': 'Depths checked against Approved Document A; prices from Checkatrade, August 2026',
  // scheme and tax rules, not lender or FCA figures
  'first-homes-scheme-calculator': 'Checked against GOV.UK First Homes guidance and planning practice guidance, 2026',
  'buy-to-let-yield-calculator': 'Checked against GOV.UK and HMRC landlord and Stamp Duty guidance, 2026',
  // planning rules from the Planning Portal, prices from published cost guides
  'extension-cost-calculator': 'Checked against the Planning Portal and published cost guides, 2026',
  'staircase-calculator': 'Checked against Approved Document K and published cost guides, 2026',
  // the tax figures are GOV.UK's; the FCA sets none of them and growth rates are the reader's own
  'cost-of-delay-calculator': 'ISA, CGT and HMRC interest figures checked against GOV.UK; growth rates are assumptions',
}

// Money/regulatory categories carry a dated verification badge; utility
// categories (tools/math) have no government rates to verify.
const DATED_BADGE_CATEGORIES = new Set([
  'tax', 'pay', 'pension', 'mortgage', 'loans', 'business', 'investment',
  'benefits', 'auto', 'energy', 'education', 'immigration', 'legal', 'farming',
])
// A slug override changes the wording only; the dated badge goes only where there are
// no government rates behind the page (grade and exam tools).
const NO_BADGE_SLUGS = new Set([
  'gcse-grade-calculator', 'a-level-grade-calculator', 'gpa-calculator', 'exam-score-calculator',
  'weighted-grade-calculator', 'progress-8-calculator', 'ks2-sats-scaled-score-calculator',
  'degree-classification-calculator',
])
const showDatedBadge = !!category && DATED_BADGE_CATEGORIES.has(category) && !NO_BADGE_SLUGS.has(slug)

const VERIFICATION_BY_CATEGORY: Record<string, string> = {
  tax: 'Verified against HMRC and GOV.UK 2026/27 rates',
  pay: 'Verified against HMRC and GOV.UK 2026/27 rates',
  pension: 'Verified against HMRC and GOV.UK 2026/27 rates',
  benefits: 'Verified against GOV.UK 2026/27 thresholds',
  business: 'Verified against HMRC and GOV.UK 2026/27 rates',
  mortgage: 'Verified against UK lender and FCA 2026 guidance',
  loans: 'Verified against UK lender and FCA 2026 guidance',
  investment: 'Verified against HMRC and FCA 2026/27 limits',
  auto: 'Verified against DVLA and GOV.UK 2026 figures',
  health: 'Verified against NHS and GOV.UK 2026 guidance',
  building: 'Verified against UK building regulations 2026',
  energy: 'Verified against Ofgem and Ofwat 2026 price caps and tariffs',
  education: 'Verified against SLC, SAAS and GOV.UK 2026/27 figures',
  immigration: 'Verified against GOV.UK and UKVI 2026 rules and fees',
  insurance: 'Verified against ABI and FCA 2026 guidance',
  legal: 'Verified against GOV.UK 2026 guidance',
  farming: 'Verified against Defra and GOV.UK 2026 guidance',
  gardening: 'Verified against RHS 2026 guidance',
  tools: 'Methodology reviewed for 2026',
  math: 'Methodology reviewed for 2026',
}
const verificationText = VERIFICATION_BY_SLUG[slug] || (category && VERIFICATION_BY_CATEGORY[category]) || 'Methodology reviewed for 2026'
---

<div class="flex items-center gap-3 py-3 border-y border-border mb-6">
  <img
    src="/author.jpg"
    alt="Konstantin Iakovlev"
    width="36"
    height="36"
    class="h-9 w-9 rounded-full object-cover shrink-0"
    onerror="this.style.display='none'"
    loading="lazy"
  />
  <div class="flex-1 min-w-0 text-sm">
    <p class="text-foreground">
      By <a href="/about/" class="font-medium hover:text-primary transition-colors">Konstantin Iakovlev</a>
      <span class="text-muted-foreground"> · Founder, Calks.uk</span>
    </p>
    <p class="text-xs text-muted-foreground">
      Last updated: <time>{lastUpdated}</time> · {verificationText}
    </p>
    {showDatedBadge && (
      <p class="mt-1 inline-flex items-center gap-1 rounded-md bg-green-100 dark:bg-green-950 px-1.5 py-0.5 text-[11px] font-medium text-green-800 dark:text-green-400">
        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
        Rates verified: {RATES_VERIFIED}
      </p>
    )}
  </div>
  <a
    href="/methodology/"
    class="text-xs text-muted-foreground hover:text-foreground transition-colors hidden sm:inline"
    aria-label="Methodology"
  >
    How we calculate
  </a>
</div>
