---
import Layout from '@/layouts/Layout.astro'
import { getWebPageSchema, getBreadcrumbSchema } from '@/utils/seo'

const schemas = [
  getWebPageSchema('Updates', 'Rate changes, new calculators and improvements to Calks.uk. Stay up to date with our latest updates.', '/updates/', '2026-06-23'),
  getBreadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Updates', url: '/updates/' },
  ]),
]
---

<Layout title="Updates" description="Rate changes, new calculators and improvements to Calks.uk. Stay up to date with our latest updates." schemas={schemas}>
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-12">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-sm text-muted-foreground mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-foreground transition-colors">Home</a>
      <span>/</span>
      <span class="text-foreground font-medium">Updates</span>
    </nav>

    <h1 class="text-3xl font-bold tracking-tight mb-2">Updates</h1>
    <p class="text-sm text-muted-foreground mb-8">Rate changes, new calculators and site improvements</p>

    <div class="space-y-8">
      <!-- July 2026 — Tier-2 constants refresh -->
      <article class="relative pl-8 border-l-2 border-primary/20">
        <div class="absolute -left-2 top-0 h-4 w-4 rounded-full bg-primary"></div>
        <div class="mb-2">
          <span class="inline-flex items-center rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary">
            July 2026
          </span>
        </div>
        <h2 class="text-lg font-semibold mb-2">Pensions, court fees, Right to Buy, student loans &amp; a new mansion-tax tool</h2>
        <ul class="text-sm text-muted-foreground space-y-2">
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-green-500 shrink-0"></span>
            <span><strong class="text-foreground">Teachers' Pension 2026/27 contributions</strong> — updated to the new salary bands and rates (7.4% up to £36,199, rising to 12% above £104,414) on the <a href="/calculator/teachers-pension-calculator/" class="text-primary hover:underline">Teachers' Pension</a> and Teacher Pay calculators.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-green-500 shrink-0"></span>
            <span><strong class="text-foreground">Right to Buy caps are now regional</strong> — following SI 2024/1073, the <a href="/calculator/right-to-buy-calculator/" class="text-primary hover:underline">Right to Buy calculator</a> lets you pick your region (London is lowest at £16,000, up to £38,000 in the South East).</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-green-500 shrink-0"></span>
            <span><strong class="text-foreground">Court hearing fees refreshed</strong> to the current EX50 scale (small-claims £27–£346, fast track £619, multi-track £1,334) on the <a href="/calculator/court-fee-calculator/" class="text-primary hover:underline">Court Fee calculator</a>.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-green-500 shrink-0"></span>
            <span><strong class="text-foreground">Student maintenance loan minimums fixed</strong> for 2026/27 (London £10,991, outside London £7,739, at home £6,060) on the <a href="/calculator/student-maintenance-loan-calculator/" class="text-primary hover:underline">Maintenance Loan calculator</a>.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-green-500 shrink-0"></span>
            <span><strong class="text-foreground">New High-Value Council Tax Surcharge tool</strong> — the <a href="/calculator/high-council-tax-calculator/" class="text-primary hover:underline">HVCTS calculator</a> now models the proposed £2,500–£7,500 annual charge on homes worth £2m+ from April 2028. <strong class="text-foreground">Employment Allowance</strong> guidance also updated — the £100,000 eligibility cap was abolished in April 2025.</span>
          </li>
        </ul>
      </article>

      <!-- July 2026 — AMAP mileage rate rise -->
      <article class="relative pl-8 border-l-2 border-primary/20">
        <div class="absolute -left-2 top-0 h-4 w-4 rounded-full bg-primary"></div>
        <div class="mb-2">
          <span class="inline-flex items-center rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary">
            July 2026
          </span>
        </div>
        <h2 class="text-lg font-semibold mb-2">HMRC mileage rate rises to 55p — first change since 2011</h2>
        <ul class="text-sm text-muted-foreground space-y-2">
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-green-500 shrink-0"></span>
            <span><strong class="text-foreground">Approved Mileage Allowance Payment up 45p → 55p</strong> for the first 10,000 business miles by car or van, announced 21 May 2026 and backdated to 6 April 2026 — the first rise since 2011. The 25p rate above 10,000 miles, plus the 24p motorcycle and 20p bicycle rates, are unchanged. Our <a href="/calculator/mileage-allowance-calculator/" class="text-primary hover:underline">mileage</a> and <a href="/calculator/business-mileage-record-calculator/" class="text-primary hover:underline">business-mileage</a> calculators and all related guidance now use 55p.</span>
          </li>
        </ul>
      </article>

      <!-- July 2026 — new calculators + site features -->
      <article class="relative pl-8 border-l-2 border-primary/20">
        <div class="absolute -left-2 top-0 h-4 w-4 rounded-full bg-primary"></div>
        <div class="mb-2">
          <span class="inline-flex items-center rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary">
            July 2026
          </span>
        </div>
        <h2 class="text-lg font-semibold mb-2">8 new calculators + search, sharing, favourites, print and embeds</h2>
        <ul class="text-sm text-muted-foreground space-y-2">
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-green-500 shrink-0"></span>
            <span><strong class="text-foreground"><a href="/calculator/nhs-pension-calculator/" class="text-primary hover:underline">NHS Pension</a> and <a href="/calculator/lgps-pension-calculator/" class="text-primary hover:underline">LGPS</a> calculators</strong> — career-average estimates for 1.3m NHS staff and 6m local-government members, with contribution tiers and lump-sum options</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-green-500 shrink-0"></span>
            <span><strong class="text-foreground"><a href="/calculator/tax-year-comparison-calculator/" class="text-primary hover:underline">Tax year comparison</a></strong> — your take-home in 2025/26 vs 2026/27 side by side, and what actually changed in April</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-green-500 shrink-0"></span>
            <span><strong class="text-foreground"><a href="/calculator/adoption-pay-calculator/" class="text-primary hover:underline">Adoption pay calculator</a></strong> — Statutory Adoption Pay week by week, completing our family of statutory-pay tools</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-green-500 shrink-0"></span>
            <span><strong class="text-foreground">Favourites &amp; recents</strong> — star any calculator and find it (plus your recently used ones) on the homepage; stored only on your device</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-green-500 shrink-0"></span>
            <span><strong class="text-foreground">Print / save as PDF</strong> — print any calculation cleanly (no menus or ads), ideal for taking to a broker or adviser</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-green-500 shrink-0"></span>
            <span><strong class="text-foreground">Embed on your site</strong> — every calculator now has an embeddable widget: click "Embed" to copy the iframe code</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-green-500 shrink-0"></span>
            <span><strong class="text-foreground"><a href="/calculator/winter-fuel-payment-calculator/" class="text-primary hover:underline">Winter Fuel Payment calculator</a></strong> — will you get the 2026/27 payment, how much, and does the &pound;35,000 income test claw it back? Includes the opt-out deadline (20 September 2026)</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-green-500 shrink-0"></span>
            <span><strong class="text-foreground"><a href="/calculator/pro-rata-salary-calculator/" class="text-primary hover:underline">Pro-rata salary calculator</a></strong> — part-time and term-time-only pay from an FTE salary, with holiday entitlement</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-green-500 shrink-0"></span>
            <span><strong class="text-foreground"><a href="/calculator/pension-emergency-tax-calculator/" class="text-primary hover:underline">Pension emergency tax calculator</a></strong> — Month-1 withholding on your first withdrawal, the tax actually due, and which form (P55 / P53Z / P50Z) reclaims the difference</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-green-500 shrink-0"></span>
            <span><strong class="text-foreground"><a href="/calculator/tax-refund-calculator/" class="text-primary hover:underline">Tax refund calculator</a></strong> — stopped working mid-year? Estimate your PAYE refund and see the rebates people commonly miss</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-green-500 shrink-0"></span>
            <span><strong class="text-foreground">Search from any page</strong> — the header now has instant calculator search (press <kbd class="px-1 border border-border rounded text-xs">Ctrl/⌘ K</kbd>)</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-green-500 shrink-0"></span>
            <span><strong class="text-foreground">Share your calculation</strong> — the top money calculators can now copy a link that restores your exact inputs</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-green-500 shrink-0"></span>
            <span><strong class="text-foreground">Take-home pay calculator upgraded</strong> — Scottish bands, bonus, salary sacrifice, State-Pension-age NI exemption, and a reverse mode: enter your target take-home to find the salary you need</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-green-500 shrink-0"></span>
            <span><strong class="text-foreground">"Rates verified" badge</strong> — every money calculator now shows the date its rates were last verified against official sources</span>
          </li>
        </ul>
      </article>

      <!-- June 2026 — data accuracy review -->
      <article class="relative pl-8 border-l-2 border-primary/20">
        <div class="absolute -left-2 top-0 h-4 w-4 rounded-full bg-primary"></div>
        <div class="mb-2">
          <span class="inline-flex items-center rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary">
            June 2026
          </span>
        </div>
        <h2 class="text-lg font-semibold mb-2">2026/27 figures verified — accuracy corrections</h2>
        <ul class="text-sm text-muted-foreground space-y-2">
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-green-500 shrink-0"></span>
            <span><strong class="text-foreground">Every rate re-checked against official sources</strong> — all figures verified against GOV.UK, GOV.SCOT and Revenue Scotland, with ongoing weekly monitoring so changes are caught quickly</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-green-500 shrink-0"></span>
            <span><strong class="text-foreground">Agricultural wages corrected</strong> — Scotland uses a single statutory rate (&pound;12.71/hr, plus a &pound;1.91/hr qualified-worker premium), not graded tiers; the Welsh grades A&ndash;E and the 2026 Seasonal Worker visa details (42,900-place quota, &pound;340 fee, no health surcharge) now match the current orders</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-green-500 shrink-0"></span>
            <span><strong class="text-foreground">Farming payments updated</strong> — SFI winter cover-crop rate set to &pound;129/hectare and the delinked-payment (BPS) phase-out confirmed for 2027</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-green-500 shrink-0"></span>
            <span><strong class="text-foreground">Motoring, benefits &amp; legal figures refreshed</strong> — 2026/27 car tax (VED) first-year rates, Universal Credit childcare caps and work thresholds, the Right to Buy discount-cap reform, the whiplash compensation tariff, teacher pay scales and the postgraduate Master&rsquo;s loan amount</span>
          </li>
        </ul>
      </article>

      <!-- June 2026 — App Store launch -->
      <article class="relative pl-8 border-l-2 border-primary/20">
        <div class="absolute -left-2 top-0 h-4 w-4 rounded-full bg-primary"></div>
        <div class="mb-2">
          <span class="inline-flex items-center rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary">
            June 2026
          </span>
        </div>
        <h2 class="text-lg font-semibold mb-2">Now on the App Store — native iOS app launched</h2>
        <ul class="text-sm text-muted-foreground space-y-2">
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-green-500 shrink-0"></span>
            <span><strong class="text-foreground">Calks.UK is on the App Store</strong> — download the free app for iPhone and iPad: <a href="https://apps.apple.com/gb/app/calks-uk-uk-calculators/id6776149190" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">Calks.UK on the App Store</a></span>
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-green-500 shrink-0"></span>
            <span><strong class="text-foreground">Works fully offline</strong> — all 330+ calculators in your pocket, no connection needed</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-green-500 shrink-0"></span>
            <span><strong class="text-foreground">Always current</strong> — rate changes and new calculators arrive automatically, no app update required</span>
          </li>
        </ul>
      </article>

      <!-- April 2026 -->
      <article class="relative pl-8 border-l-2 border-primary/20">
        <div class="absolute -left-2 top-0 h-4 w-4 rounded-full bg-primary"></div>
        <div class="mb-2">
          <span class="inline-flex items-center rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary">
            April 2026
          </span>
        </div>
        <h2 class="text-lg font-semibold mb-2">2026/27 Tax Year — Full Rate Update</h2>
        <ul class="text-sm text-muted-foreground space-y-2">
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-green-500 shrink-0"></span>
            <span><strong class="text-foreground">All tax calculators updated</strong> — Income Tax, National Insurance, Capital Gains Tax, Dividend Tax, Stamp Duty and more now reflect 2026/27 rates effective from 6 April 2026</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-green-500 shrink-0"></span>
            <span><strong class="text-foreground">National Living Wage</strong> — Increased to &pound;12.71/hr for 21+ (was &pound;12.21), &pound;10.85 for 18–20 (was &pound;10.00), &pound;8.00 for under 18 / apprentice (was &pound;7.55)</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-green-500 shrink-0"></span>
            <span><strong class="text-foreground">State Pension</strong> — Triple-lock uprating to &pound;241.30/week (&pound;12,547.60/year), up from &pound;221.20/week</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-green-500 shrink-0"></span>
            <span><strong class="text-foreground">Student loan thresholds</strong> — Plan 1: &pound;26,900 (was &pound;24,990), Plan 2: &pound;29,385 (was &pound;27,295), Plan 4: &pound;33,795 (was &pound;31,395). Plan 5 frozen at &pound;25,000</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-green-500 shrink-0"></span>
            <span><strong class="text-foreground">Statutory pay rates</strong> — SSP up to &pound;123.25/week (was &pound;116.75), SMP/SPP &pound;194.32/week (was &pound;187.18)</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-green-500 shrink-0"></span>
            <span><strong class="text-foreground">Child Benefit</strong> — Eldest child &pound;27.05/week (was &pound;26.05), additional children &pound;17.90/week (was &pound;17.25 each)</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-green-500 shrink-0"></span>
            <span><strong class="text-foreground">Frozen rates</strong> — Personal Allowance (&pound;12,570), tax bands, NI rates (8%/2%/15%), VAT (20%), Stamp Duty bands, ISA (&pound;20,000), CGT exemption (&pound;3,000) and Inheritance Tax (&pound;325k/&pound;175k) all unchanged from 2025/26</span>
          </li>
        </ul>
      </article>

      <!-- Launch -->
      <article class="relative pl-8 border-l-2 border-primary/20">
        <div class="absolute -left-2 top-0 h-4 w-4 rounded-full bg-primary"></div>
        <div class="mb-2">
          <span class="inline-flex items-center rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary">
            April 2026
          </span>
        </div>
        <h2 class="text-lg font-semibold mb-2">Calks.uk Launch</h2>
        <ul class="text-sm text-muted-foreground space-y-2">
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-blue-500 shrink-0"></span>
            <span><strong class="text-foreground">330+ calculators</strong> — Launched with over 330 free UK calculators covering tax, salary, mortgage, pensions, VAT, benefits, business and more</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-blue-500 shrink-0"></span>
            <span><strong class="text-foreground">20 categories</strong> — Tax & HMRC, Salary & Employment, Mortgage & Property, Pensions, Savings, Loans, Business, Benefits, Motoring, Health, Construction, Energy, Education, Everyday, Insurance, Immigration, Legal, Farming, Maths and Gardening</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-blue-500 shrink-0"></span>
            <span><strong class="text-foreground">Privacy first</strong> — All calculations run in your browser. No personal data is collected or stored</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-blue-500 shrink-0"></span>
            <span><strong class="text-foreground">Dark mode</strong> — Full dark mode support across the entire site</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-blue-500 shrink-0"></span>
            <span><strong class="text-foreground">Mobile optimised</strong> — Responsive design that works on phones, tablets and desktops</span>
          </li>
        </ul>
      </article>

      <!-- Coming Soon -->
      <div class="mt-12 rounded-xl border border-border bg-muted/30 p-6">
        <h2 class="text-base font-semibold mb-2">Coming Soon</h2>
        <ul class="text-sm text-muted-foreground space-y-2">
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-amber-500 shrink-0"></span>
            <span>Save and share calculator results</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-amber-500 shrink-0"></span>
            <span>PDF export for tax calculations</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-amber-500 shrink-0"></span>
            <span>Historical tax year comparisons</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="mt-1.5 h-1.5 w-1.5 rounded-full bg-amber-500 shrink-0"></span>
            <span>Save and share calculator results</span>
          </li>
        </ul>
      </div>

      <p class="text-sm text-muted-foreground">
        Want to be notified of major updates? Email <a href="mailto:info@calks.uk" class="text-primary hover:underline">info@calks.uk</a> with "Updates" in the subject line.
      </p>
    </div>
  </div>
</Layout>
