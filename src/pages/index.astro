---
import Layout from '@/layouts/Layout.astro'
import { CATEGORIES, CATEGORY_IDS } from '@/data/categories'
import { CALCULATORS } from '@/data/calculators'
import { RATES_VERIFIED } from '@/data/site'
import { getOrganizationSchema, getWebSiteSchema, getWebPageSchema } from '@/utils/seo'
import HomeSearch from '@/components/HomeSearch'
import RecentsRow from '@/components/RecentsRow'

const popularCalculators = CALCULATORS.filter((c) => c.priority === 1).slice(0, 12)

const schemas = [
  getOrganizationSchema(),
  getWebSiteSchema(),
  getWebPageSchema(
    'Free UK Calculators — Tax, Salary, Mortgage & More',
    'Free online calculators for the UK. Income tax, salary, mortgage, VAT, stamp duty, pension, NI and more — updated for the 2026/27 tax year.',
    '/'
    // dateModified omitted → seo.ts uses current build date
  ),
]
---

<Layout
  title="Free UK Calculators — Tax, Salary, Mortgage & More | Calks.uk"
  description="Free online calculators for the UK. Income tax, salary, mortgage, VAT, stamp duty, pension, NI and more — updated for the 2026/27 tax year."
  schemas={schemas}
>
  <!-- Hero -->
  <section class="py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight">
        <span class="text-gradient-uk">Free UK</span> Calculators
      </h1>
      <p class="mt-4 text-lg sm:text-xl text-muted-foreground max-w-2xl mx-auto">
        Tax, salary, mortgage, pension, VAT and more — updated for the 2026/27 tax year. All calculations run in your browser.
      </p>

      <!-- Search -->
      <div class="mt-8 max-w-xl mx-auto">
        <HomeSearch client:load calculators={CALCULATORS.map(c => ({ slug: c.slug, title: c.title, description: c.description, category: c.category }))} />
      </div>

      <!-- Favourites + recently used (renders nothing on first visit) -->
      <div class="max-w-2xl mx-auto text-left">
        <RecentsRow client:load />
      </div>
    </div>
  </section>

  <!-- Categories Grid -->
  <section class="pb-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold mb-6">Browse by Category</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3">
        {CATEGORY_IDS.map((catId) => {
          const cat = CATEGORIES[catId]
          const count = CALCULATORS.filter((c) => c.category === catId).length
          return (
            <a
              href={`/category/${catId}/`}
              class="flex items-center gap-2.5 sm:gap-3 rounded-xl border border-border p-3 sm:p-4 hover:bg-accent hover:border-primary/30 transition-all group"
            >
              <div class={`flex h-8 w-8 sm:h-10 sm:w-10 items-center justify-center rounded-lg ${cat.color} ${cat.darkColor} shrink-0`} aria-hidden="true">
                <span class={`text-sm font-bold ${cat.iconColor} ${cat.darkIconColor}`}>{cat.name.charAt(0)}</span>
              </div>
              <div class="min-w-0 flex-1">
                <p class="text-sm font-semibold leading-tight group-hover:text-primary transition-colors">{cat.name}</p>
                <p class="text-xs text-muted-foreground mt-0.5">{count} calculator{count !== 1 ? 's' : ''}</p>
              </div>
            </a>
          )
        })}
      </div>
    </div>
  </section>

  <!-- Popular Calculators -->
  <section class="pb-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold mb-6">Popular Calculators</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {popularCalculators.map((calc) => {
          const cat = CATEGORIES[calc.category]
          return (
            <a
              href={`/calculator/${calc.slug}/`}
              class="rounded-xl border border-border p-5 hover:bg-accent hover:border-primary/30 transition-all group"
            >
              <div class="flex items-start gap-3">
                <div class={`flex h-10 w-10 items-center justify-center rounded-lg ${cat.color} ${cat.darkColor} shrink-0`}>
                  <span class={`text-sm font-bold ${cat.iconColor} ${cat.darkIconColor}`}>{calc.title.charAt(0)}</span>
                </div>
                <div class="min-w-0">
                  <div class="flex items-center gap-2">
                    <h3 class="text-sm font-semibold group-hover:text-primary transition-colors">{calc.title}</h3>
                    {calc.financialYear && (
                      <span class="inline-flex items-center rounded bg-primary/10 px-1.5 py-0.5 text-xs font-medium text-primary shrink-0">
                        {calc.financialYear}
                      </span>
                    )}
                    {calc.isTrending && (
                      <span class="inline-flex items-center rounded bg-orange-100 dark:bg-orange-950 px-1.5 py-0.5 text-xs font-medium text-orange-700 dark:text-orange-400 shrink-0">
                        New
                      </span>
                    )}
                  </div>
                  <p class="text-xs text-muted-foreground mt-1 line-clamp-2">{calc.description}</p>
                </div>
              </div>
            </a>
          )
        })}
      </div>
    </div>
  </section>

  <!-- What this site is, and how the numbers are kept current -->
  <section class="pb-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-4 text-muted-foreground leading-relaxed">
        <h2 class="text-2xl font-bold text-foreground">About Calks.uk</h2>
        <p>
          Calks.uk is a set of {CALCULATORS.length} calculators for money questions that come up in the UK,
          built and maintained by <a href="/about/" class="text-primary hover:underline">Konstantin Iakovlev</a>.
          Every tool runs entirely in your browser. Nothing you type is sent to a server, there is no sign-up,
          and there is no limit on how often you use one.
        </p>
        <p>
          The figures behind each calculator come from the body that publishes them: HMRC and GOV.UK for tax,
          National Insurance and statutory pay, the DWP for benefits, Ofgem and Ofwat for energy and water,
          the DVLA for vehicle tax, and Student Finance England and SAAS for student loans. A calculator names the
          official source behind its figures wherever there is one to name, and the tools that rely on
          government-set rates carry the date those rates were last checked, most recently {RATES_VERIFIED}.
          Where the rules differ across the UK, Scottish income tax bands and the Welsh and Scottish property
          taxes are handled separately rather than approximated from the England figures.
        </p>
        <p>
          Rates change, and when they do the calculator, the worked example and the surrounding explanation are
          corrected together. Corrections are logged on the <a href="/updates/" class="text-primary hover:underline">updates page</a>,
          including the ones where we got something wrong, and the
          <a href="/methodology/" class="text-primary hover:underline">methodology page</a> sets out how each
          tool is built and checked. If a result looks wrong to you, please
          <a href="/contact/" class="text-primary hover:underline">tell us</a>.
        </p>
      </div>
    </div>
  </section>
</Layout>
